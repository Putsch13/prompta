{
  "manifest_version": 3,
  "name": "Prompta Everywhere",
  "description": "L'assistant qui voit vos pages, agit sur vos apps et pilote votre navigateur sous vos yeux : réponse instantanée, ou agent complet avec validations.",
  "version": "0.4.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Prompta — donner un ordre à l'IA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-bar": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Ouvrir / fermer la barre Prompta"
    }
  },
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://prompta-sjtf.onrender.com/*"]
}
