# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Stripe ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_id_here

# ── Email ──
RESEND_API_KEY=re_your_resend_key_here
# RESEND_FROM_EMAIL=Prompta <noreply@prompta.fr>

# ── Monitoring & analytics ──
# SENTRY_DSN=https://your_sentry_dsn_here
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key_here

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mode B2B landing : hidden (défaut) | teaser | full
NEXT_PUBLIC_B2B_LANDING_MODE=hidden

# ── Chiffrement clés utilisateur (BYOK) — OBLIGATOIRE ──
# Générer avec : openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_here

# ── Composio (800+ intégrations — backend connecteurs marketplace) ──
# Project API Key (ak_...), pas l'org token. Voir docs/COMPOSIO-SETUP.md
# COMPOSIO_API_KEY=your_composio_api_key_here

# ── Connecteurs OAuth natifs (fallback si Composio absent) ──
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# SLACK_CLIENT_ID=your_slack_client_id_here
# SLACK_CLIENT_SECRET=your_slack_client_secret_here
# CANVA_CLIENT_ID=your_canva_client_id_here
# CANVA_CLIENT_SECRET=your_canva_client_secret_here

# ── OAuth state signing ──
# openssl rand -hex 32
# OAUTH_STATE_SECRET=your_oauth_state_secret_here

# ── Clés plateforme LLM (quota gratuit / mode crédits sans BYOK) ──
# PLATFORM_OPENAI_KEY=your_platform_openai_key_here
# PLATFORM_ANTHROPIC_KEY=your_platform_anthropic_key_here
# PLATFORM_GOOGLE_KEY=your_platform_google_key_here
# PLATFORM_MISTRAL_KEY=your_platform_mistral_key_here
# PLATFORM_SERPER_KEY=your_serper_key_here

# ── Agents admin internes (Claude) ──
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AGENT_MODEL=claude-sonnet-4-6

# ── Coupe-circuit mode crédits plateforme ──
# Plafond coût API journalier en cents (défaut 500 €)
# PLATFORM_DAILY_COST_CAP_CENTS=50000

# ── Protection routes cron & worker ──
# openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# ── Seed admin (scripts/seed-admin.ts — ne pas committer le mot de passe) ──
# ADMIN_EMAIL=admin@prompta.fr
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# ── Sandbox code arbitraire (optionnel) ──
# E2B_API_KEY=your_e2b_api_key_here
