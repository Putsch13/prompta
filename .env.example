# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ── Email ──
RESEND_API_KEY=re_...

# ── Monitoring & analytics ──
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature flags ──
# Mode B2B landing : hidden (défaut) | teaser | full
NEXT_PUBLIC_B2B_LANDING_MODE=hidden

# ── Chiffrement clés utilisateur (BYOK) ──
ENCRYPTION_KEY=

# ── Agents admin (Claude) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Protection routes cron ──
CRON_SECRET=

# ── Seed admin (scripts/seed-admin.ts — ne pas committer le mot de passe) ──
# ADMIN_EMAIL=admin@prompta.fr
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# ── Sandbox code arbitraire (optionnel) ──
# E2B_API_KEY=
# PLATFORM_OPENAI_KEY=
# PLATFORM_ANTHROPIC_KEY=
# PLATFORM_GOOGLE_KEY=
# PLATFORM_MISTRAL_KEY=
