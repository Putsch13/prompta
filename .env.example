# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ── Email ──
RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Prompta <noreply@prompta.fr>

# ── Monitoring & analytics ──
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mode B2B landing : hidden (défaut) | teaser | full
NEXT_PUBLIC_B2B_LANDING_MODE=hidden

# ── Chiffrement clés utilisateur (BYOK) ──
# openssl rand -hex 32 — fallback : SUPABASE_SERVICE_ROLE_KEY si absent
ENCRYPTION_KEY=

# ── Composio (800+ intégrations — backend connecteurs marketplace) ──
# Project API Key (ak_...), pas l'org token. Voir docs/COMPOSIO-SETUP.md
COMPOSIO_API_KEY=

# ── Connecteurs OAuth natifs (fallback si Composio absent) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ── Clés plateforme LLM (quota gratuit / mode crédits sans BYOK) ──
# PLATFORM_OPENAI_KEY=
# PLATFORM_ANTHROPIC_KEY=
# PLATFORM_GOOGLE_KEY=
# PLATFORM_MISTRAL_KEY=

# ── Agents admin internes (Claude) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Coupe-circuit mode crédits plateforme (SCALE-5) ──
# Plafond coût API journalier en cents (défaut 500 €)
# PLATFORM_DAILY_COST_CAP_CENTS=50000

# ── Protection routes cron & worker ──
# openssl rand -hex 32
CRON_SECRET=

# ── Seed admin (scripts/seed-admin.ts — ne pas committer le mot de passe) ──
# ADMIN_EMAIL=admin@prompta.fr
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# ── Sandbox code arbitraire (optionnel) ──
# E2B_API_KEY=
E2B_API_KEY=e2b_acf02aa8c518f59807e4a43044b65dd55feb8e24